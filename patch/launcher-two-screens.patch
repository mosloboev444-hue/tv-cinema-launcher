+    /** Shows the cached reading at once, then refreshes it in the background when it is stale. */
+    private void refreshWeather() {
+        if (weatherPill == null) return;
+        Weather.Reading cached = Weather.cached(this);
+        showWeather(cached);
+        if (Weather.needsRefresh(cached)) {
+            Weather.refreshAsync(this, reading -> runOnUiThread(() -> {
+                if (!isFinishing() && !isDestroyed() && weatherPill != null) showWeather(reading);
+            }));
+        }
+        handler.removeCallbacks(weatherTick);
+        handler.postDelayed(weatherTick, 30 * 60 * 1000L);
+    }
+
+    private void showWeather(Weather.Reading reading) {
+        if (weatherPill == null) return;
+        if (reading == null) {
+            weatherPill.setVisibility(View.GONE);
+            return;
+        }
+        weatherPill.setText(Weather.formatTemperature(reading.temperature) + "  " + reading.condition);
+        WeatherGlyphDrawable glyph = new WeatherGlyphDrawable(reading.kind);
+        int glyphPx = Math.round(22 * density);
+        glyph.setBounds(0, 0, glyphPx, glyphPx);
+        weatherPill.setCompoundDrawablesRelative(glyph, null, null, null);
+        weatherPill.setCompoundDrawablePadding(Math.round(9 * density));
+        weatherPill.setContentDescription(Weather.description(reading));
+        weatherPill.setVisibility(View.VISIBLE);
+    }
