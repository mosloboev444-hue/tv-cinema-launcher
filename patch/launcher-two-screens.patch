+
+    @Override
+    public void onLibraryRequested() {
+        if (appLibrary != null) appLibrary.close();
+        if (openPopup != null) openPopup.dismiss();
+        libraryFocusPending = false;
+        libraryFromTopBar = false;
+        libraryFromVpnPill = false;
+        appLibrary = new AppLibraryDialog(this, animations, reducedMotion, appLibrarySelection, libraryOkOpens, adapter::containsPackage, () -> reloadApps(false), () -> {
+            appLibrary = null;
+            openPopup = null;
+            if (libraryFromTopBar) {
+                libraryFromTopBar = false;
+                btnLibraryTop.requestFocus();
+                return;
+            }
+            boolean fromVpnPill = libraryFromVpnPill;
+            libraryFromVpnPill = false;
+            // The VPN pill can hide while the library is open (its VPN dropped): then focus goes as from the grid.
+            if (fromVpnPill && btnVpn.getVisibility() == View.VISIBLE) {
+                btnVpn.requestFocus();
+                return;
+            }
+            libraryFocusPending = true;
+            grid.post(() -> {
+                if (libraryFocusPending && appLibrary == null && hasWindowFocus() && !isFinishing()) focusLibrary();
+            });
+        }, libraryExcludedApps);
+        openPopup = appLibrary.popup;
+        appLibrary.show();
+    }
+
+    @Override
+    public void onTileFocused(int position, View card) {
+        lastFocused = position;
+        lastFocusedKey = adapter.keyAt(position);
+        // Focus restored before the first layout (cold start): the tile has no size yet, and the glass
+        // would be sized to 2*pad. Run again once the tile is laid out.
+        if (card.getWidth() == 0) {
+            card.post(() -> {
+                if (card.isFocused() && card.getWidth() > 0) onTileFocused(position, card);
+            });
+            return;
+        }
+        // Tile rect in root coordinates, using layout positions (ignores the scale animation).
+        Rect r = tileRect;
+        r.set(0, 0, card.getWidth(), card.getHeight());
+        root.offsetDescendantRectToMyCoords(card, r);
+        float pad = 6f * density;        // matches GlassView's glow inset
+        float scale = adapter.focusScale();
+        float w = card.getWidth() * scale + 2 * pad;
+        float h = card.getHeight() * scale + 2 * pad;
+        float x = r.exactCenterX() - w / 2f;
+        // advanced_effects lifts a focused grid tile by 4dp and the glass follows it; dock tiles stay put (#2135).
+        boolean lifted = advancedEffects && !DockSlots.inDockRow(dockRow, singleRow, position, COLUMNS);
+        float y = r.exactCenterY() - h / 2f - (lifted ? 4f * density : 0f);
+
+        ViewGroup.LayoutParams lp = glass.getLayoutParams();
+        if (lp.width != (int) w || lp.height != (int) h || card.getWidth() != glassCardW) {
+            lp.width = (int) w;
+            lp.height = (int) h;
+            glass.setLayoutParams(lp);
+            // GlassView draws its slab inset by pad, i.e. exactly over the zoomed tile: same corners as the tile.
+            glass.setRadius(AppAdapter.cornerRadius(card.getWidth(), density) * scale);
+        }
+        glassCardW = card.getWidth();
+        glassCardRect.set(r);
+        glassTargetX = x;
+        glassTargetY = y;
+        // Cinematic shelf: the highlight glows in the dock app's colour, plain white in the grid (and on the dock with
+        // cinematic_white_focus). app_glow: every tile. In a single row every tile is the dock's kind.
+        boolean coloured = (appGlow || cinematic && !cinematicWhiteFocus && (singleRow || position < COLUMNS)) && !festive;
+        int accent = coloured ? adapter.ambientColorAt(position) : 0;
+        if ((cinematic || appGlow) && !festive && accent != glassAccent) {
+            glassAccent = accent;
+            glass.setAccent(accent);
+        }
+        if (!glassShown) {
+            springX.cancel();
+            springY.cancel();
+            glass.setTranslationX(x);
+            glass.setTranslationY(y);
+            if (animations && !reducedMotion) glass.animate().alpha(1f).setDuration(180).start();
+            else glass.setAlpha(1f);
+            glassShown = true;
+        } else if (!animations) {
+            springX.cancel();
+            springY.cancel();
+            glass.setTranslationX(x);
+            glass.setTranslationY(y);
+        } else {
+            springX.animateToFinalPosition(x - glassScrollShiftX);
+            springY.animateToFinalPosition(y - glassScrollShift);
+        }
+        View item = (View) card.getParent();
+        if (dockRow && (singleRow || position < COLUMNS)) {
+            // Dock: park it at the bottom of the screen and show the top shelf for this app. In a single row
+            // every tile is in the dock's row, which never scrolls vertically.
+            int decoratedTop = item.getTop() - (int) (6 * density);
+            int dy = decoratedTop - grid.getPaddingTop();
+            // A 1px mismatch used to start a scroll on every dock move. Only scroll when the row is
+            // actually off; reduced motion does it in one jump so it does not fight the highlight.
+            boolean scroll = !singleRow && Math.abs(dy) > (int) (8 * density);
+            if (scroll) {
+                if (!animations || reducedMotion) grid.scrollBy(0, dy);
+                else grid.smoothScrollBy(0, dy);
+            }
+            showHero(position, scroll ? r.top - dy : r.top);
+        } else {
+            // Below the dock (or in a plain grid) the glow follows the tile without the big name; letting it
+            // fade out left the grid on plain black.
+            showGlowOnly(position);
+            // Scroll just enough so the whole glass (not only the tile) is visible.
+            revealRect.set(0, -(int) pad * 2, item.getWidth(), item.getHeight() + (int) pad);
+            grid.requestChildRectangleOnScreen(item, revealRect, reducedMotion);
+        }
+    }
+
+    /** Refits the glass to the focused holder once the grid layout and tile dimensions settle. */
+    private void refitGlass() {
+        if (isDestroyed() || adapter.appCount() == 0 || libraryFocusPending) return;
+        int pos = Math.max(0, Math.min(lastFocused, adapter.appCount() - 1));
+        RecyclerView.ViewHolder vh = grid.findViewHolderForAdapterPosition(pos);
+        View card = vh == null ? null : vh.itemView.findViewById(R.id.card);
+        if (card == null || card.getWidth() <= 0 || !card.isFocused()) return;
+        float pad = 6f * density;
+        float scale = adapter.focusScale();
+        int w = (int) (card.getWidth() * scale + 2 * pad);
+        int h = (int) (card.getHeight() * scale + 2 * pad);
+        // The tile's rect, not only its width: the grid's top padding lands after the tile has its width, so a
+        // cold start can leave the glass at the right size and the wrong place. Comparing the rect catches that.
+        Rect r = tileRect;
+        r.set(0, 0, card.getWidth(), card.getHeight());
+        root.offsetDescendantRectToMyCoords(card, r);
+        if (!glassShown || card.getWidth() != glassCardW || glass.getWidth() != w || glass.getHeight() != h
+                || !glassCardRect.equals(r)) {
+            onTileFocused(pos, card);
+        }
+    }
+
+    // ---- top shelf -------------------------------------------------------------------------------
+
+    /**
+     * cinema profile: the focused app's name in a small chip instead of the large shelf title, like the reference
+     * screen. The chip follows the focused tile; the dock itself is a single row, so every tile is a dock tile.
+     */
+    private void setUpCinemaChip() {
+        hero.setVisibility(View.VISIBLE);
+        heroName.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f);
+        heroName.setLetterSpacing(0.01f);
+        heroName.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+        int hpad = Math.round(18 * density), vpad = Math.round(8 * density);
+        heroName.setPadding(hpad, vpad, hpad, vpad);
+        GradientDrawable chip = new GradientDrawable();
+        chip.setColor(0xE6151922);
+        chip.setCornerRadius(14 * density);
+        heroName.setBackground(chip);
+    }
+
+    /** Puts the chip centred above the focused tile; the grid has scrolled the tile into place by now. */
+    private void positionChip(int position, float dockTopInRoot) {
+        String label = adapter.labelAt(position);
+        if (!label.contentEquals(heroName.getText())) heroName.setText(label);
+        hero.measure(View.MeasureSpec.UNSPECIFIED, View.MeasureSpec.UNSPECIFIED);
+        float w = hero.getMeasuredWidth(), h = hero.getMeasuredHeight();
+        int gridWidth = grid.getWidth() > 0 ? grid.getWidth() : root.getWidth();
+        float cx = gridWidth / 2f;
+        RecyclerView.ViewHolder vh = grid.findViewHolderForAdapterPosition(position);
+        if (vh != null) {
+            Rect r = new Rect(0, 0, vh.itemView.getWidth(), vh.itemView.getHeight());
+            root.offsetDescendantRectToMyCoords(vh.itemView, r);
+            cx = r.centerX();
+        }
+        float x = Math.max(16 * density, Math.min(cx - w / 2f, gridWidth - w - 16 * density));
+        hero.animate().cancel();
+        hero.setVisibility(View.VISIBLE);
+        hero.setAlpha(1f);
+        hero.setTranslationX(0f);
+        hero.setX(x);
+        hero.setY(dockTopInRoot - 26 * density - h);
+        heroShown = true;
+    }
