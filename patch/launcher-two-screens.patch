+    @Override
+    public void onWindowFocusChanged(boolean hasFocus) {
+        super.onWindowFocusChanged(hasFocus);
+        if (hasFocus) {
+            startPendingSettingsReorder();
+            if (libraryFocusPending && appLibrary == null) focusLibrary();
+            showCardPrompt();
