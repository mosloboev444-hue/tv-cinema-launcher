-                : singleRow ? lm.getDecoratedLeft(firstView) - grid.getPaddingLeft()
-                : lm.getDecoratedTop(firstView) - grid.getPaddingTop();
-        change.run();
-        if (firstView != null) lm.scrollToPositionWithOffset(first, offset);
