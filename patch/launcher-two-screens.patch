+        super.onStart();
+        stopped = false;
+        started = true;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            registerReceiver(timeReceiver, timeFilter, Context.RECEIVER_NOT_EXPORTED);
+        } else {
+            registerReceiver(timeReceiver, timeFilter);
