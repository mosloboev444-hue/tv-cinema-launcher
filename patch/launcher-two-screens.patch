+    @Override
+    protected void onStop() {
+        super.onStop();
+        started = false;
+        unregisterReceiver(timeReceiver);
+        clockRefresh.stop();
+        handler.removeCallbacks(clockCheck);
+        stopped = true;
+        tileRefresh.onStop();
